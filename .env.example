# ==============================================================================
# CodeSecure AI — Environment Configuration Template
# Copy this file to .env and adjust variables as required.
# ==============================================================================

# Application Meta
APP_NAME="CodeSecure AI"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"
STREAMLIT_PORT=8501

# Security & Authentication
SECRET_KEY="codesecure-academic-demo-jwt-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (SQLite default for local privacy)
DATABASE_URL="sqlite:///./codesecure.db"

# Local LLM (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5-coder:7b"
LLM_PROVIDER="ollama"
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT=60

# Vector Database & RAG
CHROMA_PERSIST_DIRECTORY="./chroma_db"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
RAG_TOP_K=4

# Upload & File Security Limits
MAX_UPLOAD_SIZE_MB=2
ALLOWED_FILE_EXTENSIONS=".c,.cpp,.h,.hpp,.cc,.cxx,.log,.txt"
ALLOWED_REPOSITORIES_DIR="./repositories"
