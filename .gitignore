chroma_db/
.chroma/

# Evaluation outputs and caches
evaluation/results/*.tmp
.pytest_cache/
.coverage
htmlcov/

# IDE files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Temporary scratch and logs
logs/*.log
*.log
scratch/
