# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C / C++ build artifacts
*.o
*.obj
*.exe
*.out
*.dylib
*.so
*.a

# Virtual Environments
.venv/
venv/
ENV/
env/

# Environment files with potential local secrets
.env
!.env.example

# Local SQLite databases
*.db
*.sqlite3

